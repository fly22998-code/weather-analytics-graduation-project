# =========================
# Project ports / 项目端口
# =========================
COMPOSE_PROJECT_NAME=weather
FRONTEND_PORT=8080
BACKEND_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379

# Frontend build-time settings / 前端构建配置
# Browser requests will use this address after the Vue app is built.
# Vue 构建后，浏览器会使用这个地址请求后端接口。
VITE_API_BASE_URL=http://localhost:8000
VITE_API_SIGN_SECRET=replace-with-your-sign-secret

# =========================
# MySQL container settings / MySQL 容器配置
# =========================
MYSQL_DATABASE=weather
MYSQL_USER=weather_user
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-your-root-password

# =========================
# Django basic settings / Django 基础配置
# =========================
DJANGO_SECRET_KEY=replace-with-your-django-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,django-api

# Django database settings / Django 数据库配置
DB_NAME=weather
DB_USER=weather_user
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=db
DB_PORT=3306

# Redis settings / Redis 配置
REDIS_URL=redis://redis:6379/1
REDIS_PASSWORD=

# JWT settings / JWT 配置
JWT_SECRET_KEY=replace-with-your-jwt-secret
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Mail settings / 邮件配置
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=replace@example.com
EMAIL_HOST_PASSWORD=replace-with-your-email-auth-code
DEFAULT_FROM_EMAIL=Weather App <replace@example.com>

# Weather API settings / 天气接口配置
SENIVERSE_API_KEY=replace-with-your-seniverse-key
QWEATHER_PRIVATE_KEY=replace-with-your-qweather-private-key
QWEATHER_KID=replace-with-your-qweather-kid
QWEATHER_SUB=replace-with-your-qweather-sub

# Custom request signature / 自定义请求签名
API_SIGN_SECRET=replace-with-your-sign-secret
