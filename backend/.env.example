# =========================
# Django 基础配置 / Django basic settings
# =========================

# Django 项目密钥 / Django project secret key
DJANGO_SECRET_KEY=replace-with-your-django-secret

# 是否开启调试模式 True / False / Whether to run in debug mode: True / False
DJANGO_DEBUG=True

# 允许访问的主机，多个用逗号分隔 / Allowed hosts, separated by commas
# 示例 / Example: localhost,127.0.0.1,api.your-domain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# =========================
# MySQL 数据库配置 / MySQL database settings
# =========================

# 数据库名称 / Database name
DB_NAME=weather

# 数据库用户名 / Database user
DB_USER=root

# 数据库密码 / Database password
DB_PASSWORD=replace-with-your-db-password

# 数据库主机 / Database host
DB_HOST=localhost

# 数据库端口 / Database port
DB_PORT=3306

# =========================
# Redis 缓存配置 / Redis cache settings
# =========================

# Redis 连接地址 / Redis connection URL
REDIS_URL=redis://127.0.0.1:6379/1

# Redis 密码，没有可留空 / Redis password, leave empty if not required
REDIS_PASSWORD=

# =========================
# JWT 鉴权配置 / JWT authentication settings
# =========================

# JWT 签名密钥 / JWT signing secret
JWT_SECRET_KEY=replace-with-your-jwt-secret

# Access Token 过期时间（分钟） / Access token expiration time in minutes
JWT_ACCESS_EXPIRE_MINUTES=15

# Refresh Token 过期时间（天） / Refresh token expiration time in days
JWT_REFRESH_EXPIRE_DAYS=7

# =========================
# 邮件 SMTP 配置 / Mail and SMTP settings
# =========================

# SMTP 服务器地址 / SMTP host
EMAIL_HOST=smtp.qq.com

# SMTP 端口 / SMTP port
EMAIL_PORT=465

# 是否启用 SSL True / False / Whether to use SSL: True / False
EMAIL_USE_SSL=True

# 发件邮箱账号 / Mail account username
EMAIL_HOST_USER=replace@example.com

# 邮箱授权码或密码 / Mail authorization code or password
EMAIL_HOST_PASSWORD=replace-with-your-email-auth-code

# 默认发件人名称和邮箱 / Default sender name and email
DEFAULT_FROM_EMAIL=天气应用<replace@example.com>

# =========================
# 第三方天气接口配置 / Third-party weather API settings
# =========================

# 心知天气 API Key / Seniverse weather API key
SENIVERSE_API_KEY=replace-with-your-seniverse-key

# 和风天气私钥，保留换行 / QWeather private key, keep line breaks as-is
QWEATHER_PRIVATE_KEY=replace-with-your-qweather-private-key

# 和风天气 KID / QWeather KID
QWEATHER_KID=replace-with-your-kid

# 和风天气 SUB / QWeather SUB
QWEATHER_SUB=replace-with-your-sub

# =========================
# 自定义接口签名配置 / Custom request signature settings
# =========================

# 接口签名密钥 / API signing secret used by your request signature logic
API_SIGN_SECRET=replace-with-your-sign-secret
