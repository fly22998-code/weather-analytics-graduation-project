# For local frontend development only / 仅用于前端本地开发
# Do not use this file for Docker Compose deployment / Docker Compose 部署时不要使用这个文件

# 前端接口基础地址 / Frontend API base URL
# 本地示例 / Local example: http://localhost:8000
# 生产示例 / Production example: https://api.your-domain.com
VITE_API_BASE_URL=http://localhost:8000

# 前端请求签名密钥 / Frontend request signing secret
# 只有在后端仍要求前端参与签名时才填写 / Only fill this if your backend still requires frontend-side signature generation
# 公开仓库不要提交真实值 / Never commit the real value to a public repository
VITE_API_SIGN_SECRET=replace-with-your-sign-secret
